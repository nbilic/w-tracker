{
  "appId": "dev.nbilic.workout",
  "appName": "Workout Tracker",
  "webDir": "www",
  "backgroundColor": "#0e0d0c",
  "android": {
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "SystemBars": {
