<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget (see WorkoutWidget.java). Colors follow the app's dark theme. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/widget_bg">

    <TextView
        android:id="@+id/w_eyebrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NEXT UP"
        android:textColor="#E97A52"
        android:textSize="10sp"
        android:fontFamily="monospace"
        android:letterSpacing="0.16" />

    <TextView
        android:id="@+id/w_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Open the app"
        android:textColor="#F5F1EC"
        android:textSize="20sp"
        android:fontFamily="serif"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/w_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#85807A"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- Spacer (widgets only allow layouts and a few views, so no plain View) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal">
            <TextView android:id="@+id/w_d0" style="@style/WidgetDay" />
            <TextView android:id="@+id/w_d1" style="@style/WidgetDay" />
            <TextView android:id="@+id/w_d2" style="@style/WidgetDay" />
            <TextView android:id="@+id/w_d3" style="@style/WidgetDay" />
            <TextView android:id="@+id/w_d4" style="@style/WidgetDay" />
            <TextView android:id="@+id/w_d5" style="@style/WidgetDay" />
            <TextView android:id="@+id/w_d6" style="@style/WidgetDay" />
        </LinearLayout>

        <TextView
            android:id="@+id/w_action"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="@drawable/widget_button"
            android:text="Open"
            android:textColor="#1A0F08"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
